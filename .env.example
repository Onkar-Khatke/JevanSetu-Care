# ==============================================================================
# JeevanSetu AI - Environment Variables Reference Configuration
# NOTE: Use placeholders only. Never commit production credentials or secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration (Spring Boot - Port 8080)
# ------------------------------------------------------------------------------
PORT=8080

# MongoDB Connection String (Local default or Atlas MongoDB URL)
# Example local: mongodb://localhost:27017/jeevansetu
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/jeevansetu?retryWrites=true&w=majority
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/jeevansetu

# JWT Stateless Token Configuration (Minimum 256-bit secret string for HS256)
JWT_SECRET=your-secure-256-bit-jwt-secret-key-placeholder-change-in-production
JWT_EXPIRATION_MS=86400000

# IoT Telemetry Shared Ingestion Secret Header (X-Device-Key)
DEVICE_API_KEY=your-iot-device-authentication-key-placeholder

# ------------------------------------------------------------------------------
# AI Health Assistant Configuration
# Supported providers: "safe-fallback" (default safe local engine), "gemini", "openai", "http-service"
# ------------------------------------------------------------------------------
AI_PROVIDER=safe-fallback
AI_API_KEY=your-optional-external-ai-api-key-placeholder
AI_SERVICE_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# Frontend Application Configuration (React 18 + Vite - Port 5173)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8080/api
